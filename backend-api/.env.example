PORT=5000
MONGODB_URI=mongodb://localhost:27017/pravasatransworld
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email is sent through the Brevo API (not SMTP). Get the key at https://app.brevo.com
BREVO_API_KEY=your_brevo_api_key_here

# IMPORTANT: both from-addresses must be VERIFIED SENDERS in Brevo, or every mail is
# accepted by the API and then silently rejected at the sending stage. This is NOT the
# SMTP login (…@smtp-brevo.com) — that is a credential, not a sender address.
# Automated customer mail: OTP, status updates, document decisions. No-reply.
EMAIL_FROM_NAME=Pravasa Transworld
EMAIL_FROM_ADDRESS=noreply@pravasatransworld.com

# Mail sent to embassies and agencies. Replies come back here, so use a monitored
# mailbox. Falls back to the address above when unset.
EMBASSY_EMAIL_FROM_NAME=Pravasa Transworld Visa Desk
EMBASSY_EMAIL_FROM_ADDRESS=visa@pravasatransworld.com

ADMIN_EMAIL=admin@pravasatransworld.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Super Admin
ADMIN_PHONE=9999999999

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ENCRYPTION_KEY=your_secure_32_byte_string_here

# Groq Vision API (free) — used for passport & document OCR
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here


# Local developer panel at /dev. Unauthenticated, so only enable it on your own machine.
# ENABLE_DEV_PANEL=true

# Only for serverless hosting (e.g. Vercel), where the payment-reminder loop can't run.
# Have a scheduler call GET /api/cron/payment-reminders every minute with
# "Authorization: Bearer <CRON_SECRET>". Leave unset on a normal server.
# CRON_SECRET=a_long_random_string

# AI content writer in the admin portal (Groq). Falls back to GROQ_API_KEY when unset.
GROQ_CONTENT_API_KEY=your_groq_api_key_here
# GROQ_CONTENT_MODEL=openai/gpt-oss-120b
